# Production Release Key Configuration Template
# Copy this file to 'android/key.properties' and fill in your keystore credentials.
# Do NOT commit key.properties or your .jks/.keystore file to git (they are added to .gitignore).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=YOUR_KEY_ALIAS
storeFile=upload-keystore.jks
